# Supabase project (Settings -> API). Service-role key: keep secret, never commit .env
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=

# --- Worker (machine running Chrome) ---
CHROME_CDP_URL=http://127.0.0.1:9222
WORKER_ID=local
POLL_SECONDS=3
SYNC_INTERVAL_MIN=15        # 0 disables scheduled syncing
UPWORK_ALLOW_WRITE=0        # 1 lets the worker send messages

# --- MCP server ---
COMMAND_TIMEOUT=120
WORKER_STALE_SECONDS=120
